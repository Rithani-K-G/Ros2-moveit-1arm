<?xml version="1.0"?>
<robot name="one_joint_robot">

  <!-- The robot base is fixed relative to the world frame in Gazebo. -->
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- The only movable joint in this proof-of-concept robot. -->
  <group name="arm">
    <joint name="joint1"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
  </group_state>

  <!-- The two links are directly connected by joint1. -->
  <disable_collisions link1="base_link" link2="arm_link" reason="Adjacent"/>

</robot>
